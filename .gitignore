__pycache__/
*.pyc
.pytest_cache/
venv/
.venv/
*.egg-info/

# compiled test fixture binary — rebuild locally with: gcc -o fixtures/vulnerable_binary/vuln fixtures/vulnerable_binary/vuln.c
fixtures/vulnerable_binary/vuln

# core/db.py's default on-disk SQLite store — created automatically the
# first time anything (e.g. importing api/app.py, which builds a
# Database() at module level) runs without an explicit db_path. Local
# runtime state, not something to commit.
store/cart.db

# API keys / secrets (e.g. OPENAI_API_KEY for common/llm.py's optional
# LLM-in-the-loop follow-up planner) — never committed. Copy
# .env.example to .env and fill in your own key; common/llm.py loads
# .env automatically via python-dotenv if it's present.
.env
