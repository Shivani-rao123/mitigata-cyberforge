# Copy this file to .env and fill in your own key:
#   cp .env.example .env
#
# .env is gitignored — never commit your real key. common/llm.py loads
# .env automatically (via python-dotenv) if it's present; if it's
# missing, these just stay unset and the LLM follow-up planner stays
# off (its own default anyway).

# Required only if CART_LLM_FOLLOWUPS=true below. This is your OpenCode
# console API key (https://opencode.ai/v2/docs/console/api/) — common/
# llm.py talks to OpenCode's OpenAI-compatible inference gateway by
# default. If you'd rather use the real OpenAI API instead, set
# OPENAI_API_KEY here and also uncomment CART_LLM_BASE_URL below.
OPENCODE_API_KEY=...

# Turns on common/llm.py's optional LLM-in-the-loop follow-up planner.
# Unset or "false" (the default) = the existing rule-based follow-up
# logic in agents/network/agent.py and agents/web/agent.py runs
# unchanged, exactly as it always has.
CART_LLM_FOLLOWUPS=true

# Optional — defaults to OpenCode's console inference gateway. Point
# this at https://api.openai.com/v1 instead (with OPENAI_API_KEY set
# above) to use the real OpenAI API with no code change.
# CART_LLM_BASE_URL=https://opencode.ai/inference/openai/v1

# Optional — defaults to "kimi-k3" (one of OpenCode's Chat-Completions
# -compatible paid models). Must be a model your OpenCode account has
# paid access/allowance for — its free-tier models return 403 outside
# OpenCode's own CLI. Use an OpenAI model name instead (e.g. gpt-4o-mini)
# if you switched CART_LLM_BASE_URL to the real OpenAI API above.
# CART_LLM_MODEL=kimi-k3
